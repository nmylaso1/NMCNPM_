APP_ENV=local
APP_DEBUG=true

# Thông tin kết nối Aiven Cloud MySQL (hỏi trưởng nhóm để lấy thông tin thật)
DB_HOST=your-aiven-host.aivencloud.com
DB_USER=avnadmin
